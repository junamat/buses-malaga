{
  "name": "buses-malaga",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:apply:supabase-local": "psql \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f db/migrations/0001_schema_gtfs_dominio.sql -f db/migrations/0002_extensions_pg_cron_pg_net.sql",
    "supabase:reset": "npm run supabase:stop && npm run supabase:start && npm run db:apply:supabase-local",
    "localpg:up": "docker compose up -d",
    "localpg:down": "docker compose down",
    "localpg:reset": "docker compose down -v && docker compose up -d",
    "db:apply:local-postgres": "psql \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5432/buses_malaga}\" -v ON_ERROR_STOP=1 -f db/migrations/0001_schema_gtfs_dominio.sql"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "next": "14.2.35",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "20.14.15",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "fast-check": "3.22.0",
    "typescript": "5.5.4",
    "vitest": "2.1.9"
  }
}
