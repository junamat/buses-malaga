# =============================================================================
# Buses de Málaga — variables de entorno de ejemplo
# -----------------------------------------------------------------------------
# Copia este archivo a `.env.local` (ignorado por git) y rellena los valores.
# No subas secretos reales al repositorio. Los valores de abajo son
# placeholders seguros para desarrollo local.
# =============================================================================

# -----------------------------------------------------------------------------
# Modo de backend (patrón puertos/adaptadores)
# -----------------------------------------------------------------------------
# Selecciona qué conjunto de adaptadores se cablea en tiempo de ejecución.
# Alias aceptado: RUNTIME_MODE (si ambas están definidas, manda BACKEND_PROVIDER).
#
# Valores admitidos:
#   supabase-cloud  -> producción: Supabase cloud + pg_cron/pg_net + GoTrue
#   supabase-local  -> Vía A (recomendada en dev): Supabase CLI local (Docker),
#                      misma pila que producción (mismos adaptadores)
#   local-postgres  -> Vía B: Postgres + PostGIS puro, ingesta por node-worker
#                      y/o POST /api/ingest, autenticación local (usuario dev)
#
# Valor por defecto en desarrollo si se deja sin definir: supabase-local
BACKEND_PROVIDER=supabase-local
# RUNTIME_MODE=supabase-local   # alias equivalente a BACKEND_PROVIDER

# =============================================================================
# Cadena de conexión de Postgres (OBLIGATORIA en los tres modos)
# =============================================================================
# El repositorio es portable; lo único que cambia por modo es esta cadena.
# Descomenta la línea del modo que uses.
#
#   supabase-cloud : pooler/conexión del proyecto Supabase (Settings > Database)
#   supabase-local : la que imprime `supabase status` (puerto 54322 por defecto)
#   local-postgres : tu Postgres + PostGIS local (puerto 5432, ver docker-compose.yml)
#
# --- Vía A (supabase-local) — por defecto ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# --- Vía B (local-postgres) ---
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/buses_malaga
# --- Producción (supabase-cloud) ---
# DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres

# =============================================================================
# Vía A / producción — Supabase (OBLIGATORIO solo en supabase-cloud y supabase-local)
# =============================================================================
# supabase-cloud : valores del panel del proyecto (Settings > API).
# supabase-local : valores que imprime `supabase start` / `supabase status`.
#                  Las claves anon/service-role locales son fijas por proyecto;
#                  cópialas de la salida del CLI tras `supabase start`.
# En el modo local-postgres estas variables NO se usan (déjalas vacías/sin definir).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=tu-clave-anon
# Clave de servicio: SOLO en el servidor. Nunca la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# =============================================================================
# Vía B — opciones del modo local-postgres
# =============================================================================
# Usuario de desarrollo "sin login" del adaptador local-auth.
# Déjalo en "true" (o sin definir) para no requerir autenticación en dev;
# ponlo a "false" para exigir credenciales locales almacenadas en Postgres.
LOCAL_AUTH_DEV_USER=true

# -----------------------------------------------------------------------------
# Ingesta en Vía B (sin pg_cron/pg_net)
# -----------------------------------------------------------------------------
# En local-postgres la ingesta periódica la dispara el adaptador node-worker
# (setInterval) y/o el endpoint manual `POST /api/ingest` (tarea 3.2). Estas
# variables ajustan ese disparador; son OPCIONALES (tienen valores por defecto):
#
# Periodo del worker de posiciones en ms (60 s por defecto, igual que pg_cron).
# INGEST_POLL_INTERVAL_MS=60000
# Arrancar el worker automáticamente al iniciar el servidor (true) o solo
# disparar ingesta manualmente vía POST /api/ingest (false). Por defecto: false.
# Con true, si la base está vacía hace también la recarga GTFS inicial.
# Requiere reiniciar `npm run dev` tras cambiarlo.
# INGEST_WORKER_ENABLED=false
